# Kiro Crew service environment overrides.
#
# Read by kirocrew.service (EnvironmentFile=). Values set here override the
# unit's own Environment= lines. Edit, then apply with:
#
#     systemctl restart kirocrew
#
# Dashboard port (default 5476):
#KIROCREW_PORT=5476
#
# Address the dashboard binds (default: loopback only). Set to 0.0.0.0 to
# reach it from other hosts, e.g. inside a container on a MACVLAN:
#KIROCREW_BIND=0.0.0.0
